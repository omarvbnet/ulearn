// U Learn – Production PostgreSQL Schema
// Multi-country, multi-language, RBAC, soft deletes, audit-ready

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// Accelerate / Prisma Postgres pooled URL (`prisma://` or `prisma+postgres://`).
  /// Falls back to a direct `postgresql://` URL for local development.
  url       = env("DATABASE_URL")
  /// Direct Postgres URL for migrations & introspection (required when DATABASE_URL is Accelerate).
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  COUNTRY_ADMIN
  TEACHER
  STUDENT
  CERTIFICATE_USER
}

enum UserStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
}

enum Locale {
  AR
  KU
  TR
  EN
}

enum TextDirection {
  RTL
  LTR
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PackageType {
  SINGLE_SUBJECT
  FULL_STAGE
  CERTIFICATE_PROGRAM
  AI_CREATIVE
}

enum QuizType {
  LESSON
  CHAPTER
  SUBJECT_FINAL
  COURSE
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP
}

enum NotificationTarget {
  EVERYONE
  COUNTRY
  PROVINCE
  USERS
}

enum ContentType {
  VIDEO
  PDF
  ATTACHMENT
}

enum VideoScope {
  STORE_COURSE
  CURRICULUM_LESSON
  SHORT_VIDEO
}

enum VideoProcessingStatus {
  PENDING_UPLOAD
  READY
  FAILED
}

// ─────────────────────────────────────────────
// Geography
// ─────────────────────────────────────────────

model Country {
  id        String    @id @default(cuid())
  code      String    @unique // IQ, TR, etc.
  nameEn    String
  nameAr    String
  nameKu    String
  nameTr    String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  provinces          Province[]
  users              User[]
  educationalStages  EducationalStage[]
  subjects           Subject[]
  packages           SubscriptionPackage[]
  teachers           TeacherProfile[]
  notifications      Notification[]
  introOutros        IntroOutro[]
  settings           SystemSetting[]
  advertisements     Advertisement[]
  products           Product[]
  courseGroups       CourseGroup[]

  @@index([deletedAt])
}

model Province {
  id        String    @id @default(cuid())
  countryId String
  nameEn    String
  nameAr    String
  nameKu    String
  nameTr    String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  country       Country        @relation(fields: [countryId], references: [id])
  users         User[]
  teachers      TeacherProfile[]
  notifications Notification[]

  @@index([countryId])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────
// Users & Auth
// ─────────────────────────────────────────────

model User {
  id              String     @id @default(cuid())
  phone           String     @unique
  email           String?
  fullLegalName   String?
  profilePhotoKey String?
  profilePhotoUrl String?
  /// Teacher profile banner preset (0–11), rendered client-side.
  profileCoverPreset Int?
  gender          Gender?
  nationalId      String?
  nationalIdImage String?
  parentPhone     String?
  parentEmail     String?
  latitude        Float?
  longitude       Float?
  locationLabel   String?
  role            UserRole
  status          UserStatus @default(PENDING)
  locale          Locale     @default(AR)
  countryId       String?
  provinceId      String?
  lastLoginAt     DateTime?
  lastActivityAt  DateTime?
  /// When the user requested account deletion. Non-teachers are purged
  /// after 7 days without login; teachers require admin approval.
  deletionRequestedAt DateTime?
  /// Max concurrent active devices (admin-controlled). Effective limit is
  /// max(this, highest active subscription deviceLimit), at least 1.
  deviceLimit     Int        @default(1)
  fcmTokens       String[]   @default([])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  country              Country?              @relation(fields: [countryId], references: [id])
  province             Province?             @relation(fields: [provinceId], references: [id])
  studentProfile       StudentProfile?
  certificateProfile   CertificateProfile?
  teacherProfile       TeacherProfile?
  devices              Device[]
  otpCodes             OtpCode[]
  sessions             Session[]
  subscriptions        Subscription[]
  activationRequests   ActivationRequest[]
  videoProgress        VideoProgress[]
  quizAttempts         QuizAttempt[]
  questions            LessonQuestion[]      @relation("StudentQuestions")
  answers              LessonAnswer[]        @relation("TeacherAnswers")
  certificates         Certificate[]
  courseCertificates   CourseCertificate[]
  notifications        UserNotification[]
  auditLogs            AuditLog[]            @relation("ActorLogs")
  ratingsGiven         TeacherRating[]
  complaints           Complaint[]           @relation("StudentComplaints")
  complaintsHandled    Complaint[]           @relation("HandledComplaints")
  coursePurchases      CoursePurchase[]
  courseGroupPurchases CourseGroupPurchase[]
  productPurchases     ProductPurchase[]
  courseReactions      CourseReaction[]
  courseFavorites      CourseFavorite[]
  courseRatings        CourseRating[]
  lessonLikes          CourseLessonLike[]
  lessonFavorites      CourseLessonFavorite[]
  courseLessonQuestions CourseLessonQuestion[] @relation("courseLessonQuestions")
  courseLessonAnswers   CourseLessonAnswer[]   @relation("courseLessonAnswers")
  courseLessonProgress  CourseLessonProgress[]
  shortVideoLikes       ShortVideoLike[]
  shortVideoSaves       ShortVideoSave[]
  shortVideoComments    ShortVideoComment[]
  contentReports        ContentReport[]
  adLikes              AdLike[]
  stageChangeRequests  StageChangeRequest[]  @relation("StageRequests")
  videoAssets          VideoAsset[]
  aiConversations      AiConversation[]
  aiUsageLogs          AiUsageLog[]
  studentAiMemory      StudentAiMemory?
  aiMessages           AiMessage[]
  aiExamAttempts       AiExamAttempt[]
  professorJobs        ProfessorJob[]
  professorGenerations ProfessorGeneration[]
  professorArtifacts   ProfessorArtifact[]
  professorQuestions   ProfessorQuestionBankItem[]
  aiCreativeJobs       AiCreativeJob[]
  aiIapPurchases       AiIapPurchase[]

  @@index([role, status])
  @@index([countryId])
  @@index([provinceId])
  @@index([status])
  @@index([lastActivityAt])
  @@index([deletedAt])
}

model StudentProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  educationalStageId String?
  grade            String?
  schoolUniversity String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  educationalStage EducationalStage? @relation(fields: [educationalStageId], references: [id])

  @@index([educationalStageId])
}

model CertificateProfile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  educationalQualification String?
  specialization          String?
  occupation              String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests CertificateProfileInterest[]
}

/// Areas of interest for CERTIFICATE_USER (subjects under a certificate-track stage).
model CertificateProfileInterest {
  id        String   @id @default(cuid())
  profileId String
  subjectId String
  createdAt DateTime @default(now())

  profile CertificateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subject Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([profileId, subjectId])
  @@index([subjectId])
}

enum TeacherLevel {
  NEEDS_IMPROVEMENT
  GOOD
  EXCELLENT
  MASTER
}

enum TeachingTrack {
  SCHOOL
  CERTIFICATE
}

model TeacherProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  countryId      String?
  provinceId     String?
  bio            String?
  specializations String[] @default([])
  /// SCHOOL = curriculum specialties; CERTIFICATE = insights (same as cert users)
  teachingTrack  TeachingTrack @default(SCHOOL)
  isActive       Boolean   @default(true)
  level          TeacherLevel @default(GOOD)
  levelSetByAdmin Boolean  @default(false)
  levelUpdatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  country   Country?  @relation(fields: [countryId], references: [id])
  province  Province? @relation(fields: [provinceId], references: [id])
  subjects  TeacherSubject[]
  ratings   TeacherRating[]
  complaints Complaint[]
  courses   Course[]
  shortVideos TeacherShortVideo[]

  @@index([countryId])
  @@index([deletedAt])
  @@index([level])
  @@index([teachingTrack])
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  CLOSED
}

enum PurchaseStatus {
  PENDING
  PAID
  REJECTED
}

/// Teacher-authored paid course. Only visible to students when APPROVED,
/// the teacher account is active, and the teacher level is GOOD or higher.
model Course {
  id            String       @id @default(cuid())
  teacherId     String
  stageId       String
  subjectId     String
  titleEn       String
  titleAr       String?
  titleKu       String?
  titleTr       String?
  description   String?
  thumbnail     String?
  price         Float
  currency      String       @default("IQD")
  /// How many months the student keeps access after purchase (admin/teacher set).
  accessMonths  Int          @default(10)
  /// Apple IAP product id for this course (optional until configured in App Store).
  appleProductId String?
  /// Google Play product id for this course.
  googleProductId String?
  status        CourseStatus @default(DRAFT)
  reviewNotes   String?
  reviewedById  String?
  reviewedAt    DateTime?
  closedByLevel Boolean      @default(false)
  viewCount     Int          @default(0)
  /// Snapshot of course structure at last admin APPROVED (for change diffs).
  lastApprovedSnapshot Json?
  /// Diff vs lastApprovedSnapshot while status is PENDING_REVIEW.
  pendingChangeSummary Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  teacher   TeacherProfile   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  stage     EducationalStage @relation(fields: [stageId], references: [id])
  subject   Subject          @relation(fields: [subjectId], references: [id])
  lessons   CourseLesson[]
  purchases CoursePurchase[]
  reactions CourseReaction[]
  favorites CourseFavorite[]
  ratings   CourseRating[]
  quizzes   Quiz[]
  materials CourseMaterial[]
  groupItems CourseGroupItem[]
  certificates CourseCertificate[]

  @@index([teacherId])
  @@index([stageId])
  @@index([subjectId])
  @@index([status])
  @@index([deletedAt])
}

model CourseLesson {
  id            String   @id @default(cuid())
  courseId      String
  title         String
  fileKey       String?
  fileUrl       String?
  videoAssetId  String?  @unique
  thumbnailKey  String?
  thumbnailUrl  String?
  durationSec   Int?
  sortOrder     Int      @default(0)
  isFreePreview Boolean  @default(false)
  /// Partial free preview for non-purchasers (seconds from start). Null/0 = none.
  freePreviewSec Int?
  isInterview   Boolean  @default(false)
  isHidden      Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  videoAsset VideoAsset? @relation(fields: [videoAssetId], references: [id], onDelete: SetNull)
  likes     CourseLessonLike[]
  favorites CourseLessonFavorite[]
  questions CourseLessonQuestion[]
  progress  CourseLessonProgress[]
  updates   CourseLessonUpdateRequest[]
  quizzesAfter Quiz[] @relation("QuizAfterLesson")
  materials CourseMaterial[]

  @@index([courseId])
  @@index([deletedAt])
  @@index([isHidden])
}

/// Direct-upload video metadata. Binary data lives only in Cloudflare R2.
model VideoAsset {
  id                String                @id @default(cuid())
  scope             VideoScope
  courseId          String?
  courseLessonId    String?
  uploadedById      String
  objectKey         String
  sourceFilename    String?
  fileSize          BigInt?
  durationSec       Int?
  width             Int?
  height            Int?
  videoCodec        String?               @default("h264")
  audioCodec        String?               @default("aac")
  watermarkApplied  Boolean               @default(false)
  processingStatus  VideoProcessingStatus @default(PENDING_UPLOAD)
  processingError   String?
  uploadedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  uploadedBy   User          @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  courseLesson CourseLesson?

  @@index([scope])
  @@index([courseId])
  @@index([processingStatus])
  @@index([uploadedById])
}

/// Supplementary files for a store course (PDFs, notes, attachments).
model CourseMaterial {
  id        String      @id @default(cuid())
  courseId  String
  lessonId  String?
  title     String
  type      ContentType @default(PDF)
  fileKey   String?
  fileUrl   String?
  fileSize  Int?
  mimeType  String?
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  course Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson CourseLesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([lessonId])
  @@index([deletedAt])
}

/// Student Q&A on a store-course lesson (curriculum lessons have their
/// own LessonQuestion/LessonAnswer models).
model CourseLessonQuestion {
  id        String   @id @default(cuid())
  lessonId  String
  userId    String
  body      String
  createdAt DateTime @default(now())

  lesson  CourseLesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user    User                 @relation("courseLessonQuestions", fields: [userId], references: [id], onDelete: Cascade)
  answers CourseLessonAnswer[]

  @@index([lessonId])
}

model CourseLessonAnswer {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  body       String
  createdAt  DateTime @default(now())

  question CourseLessonQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User                 @relation("courseLessonAnswers", fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

/// Watch progress for store-course videos.
model CourseLessonProgress {
  id            String   @id @default(cuid())
  userId        String
  lessonId      String
  positionSec   Int      @default(0)
  durationSec   Int      @default(0)
  completionPct Float    @default(0)
  isCompleted   Boolean  @default(false)
  lastWatchedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

enum LessonUpdateStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Pending lesson media edits on live courses — admin must approve first.
model CourseLessonUpdateRequest {
  id           String             @id @default(cuid())
  lessonId     String
  teacherId    String
  title        String?
  fileKey      String?
  fileUrl      String?
  thumbnailKey String?
  thumbnailUrl String?
  durationSec  Int?
  /// Snapshot of the live lesson before this proposed change.
  previousTitle        String?
  previousFileKey      String?
  previousFileUrl      String?
  previousThumbnailKey String?
  previousThumbnailUrl String?
  previousDurationSec  Int?
  /// Comma-separated change tags, e.g. "title,video,thumbnail".
  changeSummary String?
  status       LessonUpdateStatus @default(PENDING)
  reviewNotes  String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([status])
}

/// Admin-curated bundle of courses for one educational stage (Home cards).
model CourseGroup {
  id          String   @id @default(cuid())
  titleEn     String
  titleAr     String?
  titleKu     String?
  titleTr     String?
  description String?
  coverKey    String?
  coverUrl    String?
  stageId     String
  countryId   String?
  currency    String   @default("IQD")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  stage     EducationalStage     @relation(fields: [stageId], references: [id])
  country   Country?             @relation(fields: [countryId], references: [id])
  items     CourseGroupItem[]
  purchases CourseGroupPurchase[]

  @@index([stageId])
  @@index([isActive])
  @@index([deletedAt])
}

model CourseGroupItem {
  id        String @id @default(cuid())
  groupId   String
  courseId  String
  sortOrder Int    @default(0)

  group  CourseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  course Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([groupId, courseId])
  @@index([courseId])
}

model CourseGroupPurchase {
  id           String         @id @default(cuid())
  groupId      String
  userId       String
  price        Float
  currency     String         @default("IQD")
  status       PurchaseStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  expiresAt    DateTime?
  source       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  group CourseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([status])
}

/// Teacher short-form videos (reels-style).
model TeacherShortVideo {
  id           String       @id @default(cuid())
  teacherId    String
  title        String
  description  String?
  viewCount    Int          @default(0)
  fileKey      String?
  fileUrl      String?
  thumbnailUrl String?
  durationSec  Int?
  status       CourseStatus @default(PENDING_REVIEW)
  isHidden     Boolean      @default(false)
  reviewNotes  String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  teacher TeacherProfile  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  likes    ShortVideoLike[]
  saves    ShortVideoSave[]
  comments ShortVideoComment[]

  @@index([teacherId])
  @@index([status])
  @@index([deletedAt])
  @@index([isHidden])
}

model ShortVideoLike {
  id        String   @id @default(cuid())
  videoId   String
  userId    String
  createdAt DateTime @default(now())

  video TeacherShortVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@index([videoId])
}

/// Student bookmark on a teacher short video (reel).
model ShortVideoSave {
  id        String   @id @default(cuid())
  videoId   String
  userId    String
  createdAt DateTime @default(now())

  video TeacherShortVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@index([userId])
  @@index([videoId])
}

model ShortVideoComment {
  id        String    @id @default(cuid())
  videoId   String
  userId    String
  parentId  String?
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  video   TeacherShortVideo  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  ShortVideoComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ShortVideoComment[] @relation("CommentReplies")

  @@index([videoId, createdAt])
  @@index([userId])
  @@index([parentId])
}

enum ContentReportTargetType {
  SHORT_VIDEO
  SHORT_VIDEO_COMMENT
  STORE_COURSE
  STORE_LESSON
}

enum ContentReportReason {
  INAPPROPRIATE
  SPAM
  HARASSMENT
  COPYRIGHT
  VIOLENCE
  MISLEADING
  OTHER
}

enum ContentReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

/// User-submitted report on platform content (reels, courses, lessons).
model ContentReport {
  id           String                @id @default(cuid())
  reporterId   String
  targetType   ContentReportTargetType
  targetId     String
  reason       ContentReportReason
  details      String
  status       ContentReportStatus   @default(PENDING)
  adminNotes   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([status])
  @@index([targetType, targetId])
}

/// A student's purchase of a teacher course. Revenue split is snapshotted
/// at approval time using the teacher's level deduction percentage.
model CoursePurchase {
  id             String         @id @default(cuid())
  courseId       String
  userId         String
  price          Float
  currency       String         @default("IQD")
  teacherLevel   TeacherLevel?
  deductionPct   Float?
  platformAmount Float?
  teacherAmount  Float?
  status         PurchaseStatus @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  /// Access ends after this date (from course.accessMonths). Null = no expiry (legacy).
  expiresAt      DateTime?
  /// APPLE | GOOGLE | ADMIN | REQUEST
  source         String?
  iapTransactionId String?      @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// Physical product store (admin catalog)
// ─────────────────────────────────────────────

enum ProductCategory {
  PINS
  BOOKS
  BOARDS
  SUPPLIES
  STATIONERY
  OTHER
}

/// Admin-managed physical product (pins, books, boards, etc.).
model Product {
  id            String          @id @default(cuid())
  countryId     String?
  category      ProductCategory
  nameEn        String
  nameAr        String?
  nameKu        String?
  nameTr        String?
  descriptionEn String?
  descriptionAr String?
  descriptionKu String?
  descriptionTr String?
  price         Float
  currency      String          @default("IQD")
  imageKey      String?
  imageUrl      String
  images        String[]        @default([])
  stock         Int?
  sortOrder     Int             @default(0)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  country   Country?          @relation(fields: [countryId], references: [id])
  purchases ProductPurchase[]

  @@index([category, isActive, sortOrder])
  @@index([deletedAt])
}

/// Student order request for a physical product (admin confirms payment).
model ProductPurchase {
  id           String         @id @default(cuid())
  productId    String
  userId       String
  quantity     Int            @default(1)
  unitPrice    Float
  totalPrice   Float
  currency     String         @default("IQD")
  status       PurchaseStatus @default(PENDING)
  notes        String?
  userPhone    String?
  userName     String?
  userLocation String?
  productName  String
  productImage String?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([userId])
  @@index([status])
  @@index([productId])
}

enum ReactionType {
  LIKE
  DISLIKE
}

/// Student like/dislike on a store course. One reaction per user per course.
model CourseReaction {
  id        String       @id @default(cuid())
  courseId  String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId, type])
}

/// Student bookmark on a store course, shown in the profile favorites.
model CourseFavorite {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
}

/// Student like on an individual course video.
model CourseLessonLike {
  id        String   @id @default(cuid())
  lessonId  String
  userId    String
  createdAt DateTime @default(now())

  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@index([lessonId])
}

/// Student bookmark on an individual course video, shown in the profile favorites.
model CourseLessonFavorite {
  id        String   @id @default(cuid())
  lessonId  String
  userId    String
  createdAt DateTime @default(now())

  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@index([userId])
}

/// Promotional banner shown on the mobile home screen.
/// Targets language (`locale`), optional role audience, and optional educational stage.
model Advertisement {
  id        String    @id @default(cuid())
  countryId String?
  /// App language this banner is shown for (AR / KU / TR / EN).
  locale    Locale    @default(AR)
  /// Who should see this ad on Home (ALL = every role).
  audience  AdAudience @default(ALL)
  /// Optional stage scope (e.g. 3rd Intermediate). Null = all stages for that audience.
  stageId   String?
  titleEn   String?
  titleAr   String?
  titleKu   String?
  titleTr   String?
  /// Display title for the target locale (preferred over multilingual fields).
  title     String?
  imageKey  String?
  imageUrl  String
  linkUrl   String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  country Country?          @relation(fields: [countryId], references: [id])
  stage   EducationalStage? @relation(fields: [stageId], references: [id])
  likes   AdLike[]

  @@index([isActive, sortOrder])
  @@index([locale, isActive, sortOrder])
  @@index([audience, isActive, sortOrder])
  @@index([stageId])
  @@index([deletedAt])
}

enum AdAudience {
  ALL
  STUDENT
  CERTIFICATE_USER
  TEACHER
}

model AdLike {
  id        String   @id @default(cuid())
  adId      String
  userId    String
  createdAt DateTime @default(now())

  ad   Advertisement @relation(fields: [adId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([adId, userId])
  @@index([adId])
}

enum StageRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Student request to move to a different educational stage.
/// Requires a certificate attachment and admin approval.
model StageChangeRequest {
  id               String             @id @default(cuid())
  userId           String
  currentStageId   String?
  requestedStageId String
  certificateKey   String?
  certificateUrl   String?
  note             String?
  status           StageRequestStatus @default(PENDING)
  reviewNotes      String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user           User              @relation("StageRequests", fields: [userId], references: [id], onDelete: Cascade)
  currentStage   EducationalStage? @relation("StageRequestCurrent", fields: [currentStageId], references: [id])
  requestedStage EducationalStage  @relation("StageRequestRequested", fields: [requestedStageId], references: [id])

  @@index([userId])
  @@index([status])
}

model TeacherSubject {
  id        String   @id @default(cuid())
  teacherId String
  subjectId String
  createdAt DateTime @default(now())

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
}

model TeacherRating {
  id        String   @id @default(cuid())
  teacherId String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teacherId, userId])
  @@index([teacherId])
}

/// Student star rating for a completed store course (one per user per course).
model CourseRating {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId])
}

model Complaint {
  id          String    @id @default(cuid())
  studentId   String
  teacherId   String?
  subject     String
  description String
  status      String    @default("OPEN")
  handledById String?
  resolution  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?

  student   User            @relation("StudentComplaints", fields: [studentId], references: [id])
  teacher   TeacherProfile? @relation(fields: [teacherId], references: [id])
  handledBy User?           @relation("HandledComplaints", fields: [handledById], references: [id])

  @@index([studentId])
  @@index([teacherId])
  @@index([status])
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String?
  phone     String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, code])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  deviceId  String?
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Device {
  id         String   @id @default(cuid())
  userId     String
  deviceId   String
  deviceName String?
  platform   String?
  lastSeenAt DateTime @default(now())
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// Educational Structure (Country-specific)
// ─────────────────────────────────────────────

model EducationalStage {
  id          String    @id @default(cuid())
  countryId   String
  nameEn      String
  nameAr      String
  nameKu      String
  nameTr      String
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  /// Professional / certificate track (areas of interest live as subjects under this stage).
  isCertificateTrack Boolean @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  country          Country            @relation(fields: [countryId], references: [id])
  subjects         Subject[]
  packages         SubscriptionPackage[]
  studentProfiles  StudentProfile[]
  courses          Course[]
  courseGroups     CourseGroup[]
  advertisements   Advertisement[]
  stageRequestsFrom StageChangeRequest[] @relation("StageRequestCurrent")
  stageRequestsTo   StageChangeRequest[] @relation("StageRequestRequested")

  @@index([countryId])
  @@index([deletedAt])
  @@index([isCertificateTrack])
}

model Subject {
  id          String    @id @default(cuid())
  countryId   String
  stageId     String?
  nameEn      String
  nameAr      String
  nameKu      String
  nameTr      String
  description String?
  thumbnail   String?
  isCertificateProgram Boolean @default(false)
  totalHours  Float     @default(0)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  country    Country          @relation(fields: [countryId], references: [id])
  stage      EducationalStage? @relation(fields: [stageId], references: [id])
  chapters   Chapter[]
  packages   SubscriptionPackage[]
  teachers   TeacherSubject[]
  quizzes    Quiz[]
  certificates Certificate[]
  courses    Course[]
  certificateInterests CertificateProfileInterest[]

  @@index([countryId])
  @@index([stageId])
  @@index([isCertificateProgram])
  @@index([deletedAt])
}

model Chapter {
  id          String    @id @default(cuid())
  subjectId   String
  nameEn      String
  nameAr      String
  nameKu      String
  nameTr      String
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  quizzes Quiz[]

  @@index([subjectId])
  @@index([deletedAt])
}

model Lesson {
  id          String    @id @default(cuid())
  chapterId   String
  nameEn      String
  nameAr      String
  nameKu      String
  nameTr      String
  description String?
  isFree      Boolean   @default(false)
  sortOrder   Int       @default(0)
  durationSec Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  chapter   Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  contents  LessonContent[]
  quizzes   Quiz[]
  questions LessonQuestion[]
  progress  VideoProgress[]

  @@index([chapterId])
  @@index([isFree])
  @@index([deletedAt])
}

model LessonContent {
  id          String      @id @default(cuid())
  lessonId    String
  type        ContentType
  titleEn     String?
  titleAr     String?
  titleKu     String?
  titleTr     String?
  fileKey     String
  fileUrl     String?
  fileSize    Int?
  mimeType    String?
  durationSec Int?
  sortOrder   Int         @default(0)
  hasSubtitles Boolean    @default(false)
  subtitleKeys Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([type])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────
// Intro / Outro (per language)
// ─────────────────────────────────────────────

model IntroOutro {
  id        String   @id @default(cuid())
  countryId String?
  locale    Locale
  type      String   // INTRO | OUTRO
  fileKey   String
  fileUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country Country? @relation(fields: [countryId], references: [id])

  @@unique([countryId, locale, type])
  @@index([locale, type])
}

// ─────────────────────────────────────────────
// Video Progress
// ─────────────────────────────────────────────

model VideoProgress {
  id              String   @id @default(cuid())
  userId          String
  lessonId        String
  positionSec     Int      @default(0)
  durationSec     Int      @default(0)
  completionPct   Float    @default(0)
  isCompleted     Boolean  @default(false)
  totalWatchSec   Int      @default(0)
  lastWatchedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@index([isCompleted])
}

// ─────────────────────────────────────────────
// Subscriptions
// ─────────────────────────────────────────────

model SubscriptionPackage {
  id           String      @id @default(cuid())
  countryId    String
  type         PackageType
  nameEn       String
  nameAr       String
  nameKu       String
  nameTr       String
  description  String?
  price        Decimal     @db.Decimal(12, 2)
  currency     String      @default("IQD")
  durationDays Int?
  deviceLimit  Int         @default(1)
  subjectId    String?
  stageId      String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  country            Country           @relation(fields: [countryId], references: [id])
  subject            Subject?          @relation(fields: [subjectId], references: [id])
  stage              EducationalStage? @relation(fields: [stageId], references: [id])
  subscriptions      Subscription[]
  activationRequests ActivationRequest[]

  @@index([countryId])
  @@index([type])
  @@index([deletedAt])
}

model ActivationRequest {
  id          String   @id @default(cuid())
  userId      String
  packageId   String
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  notes       String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  package SubscriptionPackage  @relation(fields: [packageId], references: [id])
  codes   ActivationCode[]

  @@index([userId])
  @@index([status])
}

model ActivationCode {
  id          String    @id @default(cuid())
  requestId   String?
  code        String    @unique
  packageId   String?
  userId      String?
  usedAt      DateTime?
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  request ActivationRequest? @relation(fields: [requestId], references: [id])

  @@index([code])
}

model Subscription {
  id          String             @id @default(cuid())
  userId      String
  packageId   String
  status      SubscriptionStatus @default(PENDING)
  startsAt    DateTime?
  expiresAt   DateTime?
  deviceLimit Int                @default(1)
  activatedBy String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  package SubscriptionPackage @relation(fields: [packageId], references: [id])

  @@index([userId, status])
  @@index([expiresAt])
  @@index([status])
}

// ─────────────────────────────────────────────
// Quizzes
// ─────────────────────────────────────────────

model Quiz {
  id              String   @id @default(cuid())
  type            QuizType
  lessonId        String?
  chapterId       String?
  subjectId       String?
  courseId        String?
  /// Store-course quiz placed after a specific lesson video.
  afterLessonId   String?
  titleEn         String
  titleAr         String
  titleKu         String
  titleTr         String
  timeLimitSec    Int?
  maxAttempts     Int      @default(3)
  passPercentage  Float    @default(50)
  randomize       Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  lesson    Lesson?       @relation(fields: [lessonId], references: [id])
  chapter   Chapter?      @relation(fields: [chapterId], references: [id])
  subject   Subject?      @relation(fields: [subjectId], references: [id])
  course    Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  afterLesson CourseLesson? @relation("QuizAfterLesson", fields: [afterLessonId], references: [id], onDelete: SetNull)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([lessonId])
  @@index([chapterId])
  @@index([subjectId])
  @@index([courseId])
  @@index([afterLessonId])
  @@index([deletedAt])
}

model QuizQuestion {
  id           String       @id @default(cuid())
  quizId       String
  type         QuestionType @default(MULTIPLE_CHOICE)
  textEn       String
  textAr       String
  textKu       String
  textTr       String
  options      Json
  correctKey   String
  points       Int          @default(1)
  /// Optional per-question time limit in seconds (null = no limit for this question).
  timeLimitSec Int?
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  userId      String
  score       Float    @default(0)
  maxScore    Float    @default(0)
  percentage  Float    @default(0)
  passed      Boolean  @default(false)
  answers     Json
  startedAt   DateTime @default(now())
  completedAt DateTime?
  timeSpentSec Int?

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// Q&A
// ─────────────────────────────────────────────

model LessonQuestion {
  id          String    @id @default(cuid())
  lessonId    String
  studentId   String
  body        String
  attachmentKey String?
  attachmentUrl String?
  isResolved  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  lesson  Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student User           @relation("StudentQuestions", fields: [studentId], references: [id])
  answers LessonAnswer[]

  @@index([lessonId])
  @@index([studentId])
  @@index([isResolved])
}

model LessonAnswer {
  id            String   @id @default(cuid())
  questionId    String
  teacherId     String
  body          String
  attachmentKey String?
  attachmentUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  question LessonQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  teacher  User           @relation("TeacherAnswers", fields: [teacherId], references: [id])

  @@index([questionId])
  @@index([teacherId])
}

// ─────────────────────────────────────────────
// Certificates
// ─────────────────────────────────────────────

model Certificate {
  id               String   @id @default(cuid())
  userId           String
  subjectId        String
  certificateNumber String  @unique
  verificationCode String   @unique
  userName         String
  courseName       String
  completionDate   DateTime
  totalHours       Float
  pdfKey           String?
  pdfUrl           String?
  qrCodeData       String?
  createdAt        DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([userId, subjectId])
  @@index([verificationCode])
  @@index([certificateNumber])
}

/// Professional certificate for a completed store Course (CERTIFICATE_USER only).
model CourseCertificate {
  id                String   @id @default(cuid())
  userId            String
  courseId          String
  certificateNumber String   @unique
  verificationCode  String   @unique
  userName          String
  courseTitle       String
  courseDescription String?
  teacherName       String
  totalHours        Float
  completionDate    DateTime
  pdfKey            String?
  pdfUrl            String?
  qrCodeData        String?
  createdAt         DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([verificationCode])
  @@index([certificateNumber])
  @@index([courseId])
}

// ─────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────

model Notification {
  id          String              @id @default(cuid())
  titleEn     String
  titleAr     String
  titleKu     String
  titleTr     String
  bodyEn      String
  bodyAr      String
  bodyKu      String
  bodyTr      String
  channels    NotificationChannel[]
  target      NotificationTarget
  countryId   String?
  provinceId  String?
  userIds     String[]            @default([])
  sentAt      DateTime?
  createdById String?
  createdAt   DateTime            @default(now())

  country  Country?  @relation(fields: [countryId], references: [id])
  province Province? @relation(fields: [provinceId], references: [id])
  deliveries UserNotification[]

  @@index([target])
  @@index([countryId])
}

model UserNotification {
  id             String   @id @default(cuid())
  userId         String
  notificationId String?
  title          String
  body           String
  isRead         Boolean  @default(false)
  data           Json?
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id])

  @@index([userId, isRead])
}

// ─────────────────────────────────────────────
// Audit & System
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  previousValue Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("ActorLogs", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  countryId String?
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  country Country? @relation(fields: [countryId], references: [id])

  @@unique([countryId, key])
}

model DailyActivity {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime @db.Date
  watchTimeSec Int      @default(0)
  lessonsDone  Int      @default(0)
  quizzesTaken Int      @default(0)
  loginCount   Int      @default(0)

  @@unique([userId, date])
  @@index([date])
}

// ─────────────────────────────────────────────
// AI Knowledge Base & Provider Management (RAG)
// ─────────────────────────────────────────────

enum AiProviderType {
  GEMINI
  OPENAI
  ANTHROPIC
  OPENAI_COMPATIBLE
  KIMI
  DEEPSEEK
  JINA
  FLUX
}

enum AiProviderStatus {
  ENABLED
  DISABLED
}

enum AiModuleKey {
  TEACHING_ASSISTANT
  EXAM_GENERATOR
  OCR_ANALYSIS
  EMBEDDING
  RECOMMENDATION
  PROFESSOR_CONTENT
  PROFESSOR_DOCUMENT
  AI_CREATIVE
  AI_CREATIVE_IMAGE
}

enum KbSourceType {
  COURSE_MATERIAL
  LESSON_CONTENT
  KB_UPLOAD
  TEACHER_UPLOAD
}

enum KbDocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AiExamAttemptStatus {
  PENDING
  SUBMITTED
  EXPIRED
}

model AiProvider {
  id               String           @id @default(cuid())
  name             String
  type             AiProviderType
  /// AES-GCM encrypted API key (base64 payload).
  apiKeyEncrypted  String?
  baseUrl          String?
  model            String
  apiVersion       String?
  timeoutMs        Int              @default(60000)
  maxTokens        Int              @default(2048)
  temperature      Float            @default(0.3)
  topP             Float?
  frequencyPenalty Float?
  presencePenalty  Float?
  streaming        Boolean          @default(true)
  retryCount       Int              @default(2)
  status           AiProviderStatus @default(ENABLED)
  isDefault        Boolean          @default(false)
  sortOrder        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  moduleAssignments AiModuleAssignment[]
  usageLogs         AiUsageLog[]

  @@index([status, isDefault])
  @@index([type])
}

model AiModuleAssignment {
  id         String      @id @default(cuid())
  moduleKey  AiModuleKey @unique
  providerId String
  updatedAt  DateTime    @updatedAt

  provider AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model AiUsageLog {
  id           String   @id @default(cuid())
  providerId   String?
  userId       String?
  moduleKey    String?
  success      Boolean
  errorMessage String?
  tokensIn     Int      @default(0)
  tokensOut    Int      @default(0)
  latencyMs    Int      @default(0)
  costEstimate Float    @default(0)
  createdAt    DateTime @default(now())

  provider AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([providerId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model KbDocument {
  id              String           @id @default(cuid())
  sourceType      KbSourceType
  /// CourseMaterial / LessonContent / standalone id
  sourceId        String?
  fileName        String
  fileKey         String?
  fileUrl         String?
  mimeType        String?
  language        String?
  educationalStageId String?
  grade           String?
  subjectId       String?
  semester        String?
  chapter         String?
  lesson          String?
  topic           String?
  courseId        String?
  instructorId    String?
  version         Int              @default(1)
  status          KbDocumentStatus @default(PENDING)
  errorMessage    String?
  pageCount       Int?
  chunkCount      Int              @default(0)
  uploadedAt      DateTime         @default(now())
  processedAt     DateTime?
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  chunks   KbChunk[]
  versions KbDocumentVersion[]

  @@index([sourceType, sourceId])
  @@index([status])
  @@index([educationalStageId, subjectId])
  @@index([courseId])
  @@index([language])
  @@index([instructorId, status])
  @@index([instructorId, uploadedAt])
}

model KbDocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  version    Int
  snapshot   Json
  archivedAt DateTime @default(now())

  document KbDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
}

/// Chunk text + metadata. Embedding stored in pgvector column via raw SQL
/// (see migration). Prisma keeps a float array mirror for portability.
model KbChunk {
  id         String   @id @default(cuid())
  documentId String
  chunkIndex Int
  pageNumber Int?
  text       String
  language   String?
  /// JSON metadata copy for filters (stage, subject, lesson, …)
  metadata   Json
  version    Int      @default(1)
  /// Portable embedding copy (Gemini gemini-embedding-001 @ 768 dims)
  embedding  Float[]  @default([])
  contentHash String?
  createdAt  DateTime @default(now())

  document KbDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, chunkIndex])
  @@index([version])
  @@index([contentHash])
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     AiMessage[]
  examAttempts AiExamAttempt[]

  @@index([userId, updatedAt])
}

/// Student AI practice exams generated from KB materials (not course Quiz).
model AiExamAttempt {
  id             String              @id @default(cuid())
  userId         String
  conversationId String?
  documentIds    String[]            @default([])
  title          String
  /// Full questions including correctKey (server-only until submit response).
  questions      Json
  answers        Json?
  score          Int?
  maxScore       Int?
  percentage     Float?
  passed         Boolean?
  timeLimitSec   Int
  elapsedSec     Int?
  analysis       String?
  status         AiExamAttemptStatus @default(PENDING)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  completedAt    DateTime?

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, passed])
  @@index([conversationId])
}

model AiMessage {
  id             String        @id @default(cuid())
  conversationId String
  userId         String?
  role           AiMessageRole
  content        String
  citations      Json?
  createdAt      DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

model StudentAiMemory {
  id                 String   @id @default(cuid())
  userId             String   @unique
  weakSubjects       String[] @default([])
  strongSubjects     String[] @default([])
  frequentQuestions  Json?
  completedLessons   String[] @default([])
  examResults        Json?
  preferredStyle     String?
  learningSpeed      String?
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiResponseCache {
  id              String   @id @default(cuid())
  cacheKey        String   @unique
  questionNorm    String
  stageId         String?
  subjectId       String?
  answer          String
  citations       Json?
  embedding       Float[]  @default([])
  hitCount        Int      @default(0)
  createdAt       DateTime @default(now())
  expiresAt       DateTime?

  @@index([stageId, subjectId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// AI Professor Studio (teacher-owned)
// ─────────────────────────────────────────────

enum ProfessorJobType {
  INGEST
  GENERATE_CONTENT
  DOCUMENT_ACTION
  PDF_TOOL
  EXPORT
  GENERATE_EXAM
  GRADE_ASSIST
}

enum ProfessorJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ProfessorGenerationType {
  LECTURE
  NOTES
  STUDY_GUIDE
  TEACHING_MANUAL
  SYLLABUS
  LESSON_PLAN
  WEEKLY_PLAN
  SEMESTER_PLAN
  LEARNING_OUTCOMES
  PRESENTATION_OUTLINE
  CUSTOM
}

enum ProfessorArtifactKind {
  MARKDOWN
  HTML
  PDF
  DOCX
  PPTX
  JSON
  FLASHCARDS
  MIND_MAP
}

model ProfessorJob {
  id             String              @id @default(cuid())
  instructorId   String
  type           ProfessorJobType
  status         ProfessorJobStatus  @default(QUEUED)
  progress       Int                 @default(0)
  errorMessage   String?
  inputJson      Json?
  resultJson     Json?
  documentId     String?
  generationId   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  completedAt    DateTime?

  instructor User                 @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  generation ProfessorGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([instructorId, createdAt])
  @@index([instructorId, status])
  @@index([generationId])
}

model ProfessorGeneration {
  id           String                   @id @default(cuid())
  instructorId String
  type         ProfessorGenerationType
  title        String
  language     String                   @default("en")
  params       Json?
  markdown     String?
  status       ProfessorJobStatus       @default(QUEUED)
  version      Int                      @default(1)
  parentId     String?
  courseId     String?
  documentIds  String[]                 @default([])
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  instructor User                        @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  parent     ProfessorGeneration?        @relation("GenerationVersions", fields: [parentId], references: [id], onDelete: SetNull)
  versions   ProfessorGeneration[]       @relation("GenerationVersions")
  artifacts  ProfessorArtifact[]
  jobs       ProfessorJob[]

  @@index([instructorId, updatedAt])
  @@index([instructorId, type])
  @@index([parentId])
}

model ProfessorArtifact {
  id           String                @id @default(cuid())
  instructorId String
  generationId String?
  jobId        String?
  documentId   String?
  kind         ProfessorArtifactKind
  fileName     String
  fileKey      String?
  fileUrl      String?
  contentText  String?
  version      Int                   @default(1)
  meta         Json?
  createdAt    DateTime              @default(now())

  instructor User                 @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  generation ProfessorGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([instructorId, createdAt])
  @@index([generationId])
  @@index([documentId])
  @@index([jobId])
}

model ProfessorQuestionBankItem {
  id               String   @id @default(cuid())
  instructorId     String
  subject          String?
  chapter          String?
  lesson           String?
  topic            String?
  difficulty       String?
  bloom            String?
  questionType     String
  language         String   @default("en")
  text             String
  options          Json?
  correctKey       String?
  answerKey        String?
  marks            Float?   @default(1)
  timeEstimateSec  Int?
  courseId         String?
  documentId       String?
  generationId     String?
  examVersion      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  instructor User @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId, createdAt])
  @@index([instructorId, subject, chapter])
  @@index([instructorId, difficulty])
  @@index([instructorId, questionType])
  @@index([courseId])
}

// ─────────────────────────────────────────────
// AI Creative Studio (students / certificate users)
// ─────────────────────────────────────────────

enum AiCreativeTool {
  MERGE
  DESIGN_PPT
  DESIGN_PDF
  IMAGE_EDIT
  IMAGE_DESIGN
}

enum AiCreativeJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model AiCreativeJob {
  id             String              @id @default(cuid())
  userId         String
  tool           AiCreativeTool
  status         AiCreativeJobStatus @default(PENDING)
  inputMeta      Json?
  resultFileName String?
  resultMime     String?
  /// Base64 for binary artifacts (pdf/pptx/images); plain text for svg/html.
  resultContent  String?             @db.Text
  error          String?
  countedAsUse   Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([countedAsUse])
}

/// Apple / Google Play purchases that unlock AI_CREATIVE subscriptions.
model AiIapPurchase {
  id             String   @id @default(cuid())
  userId         String
  platform       String // APPLE | GOOGLE
  productId      String
  transactionId  String   @unique
  purchaseToken  String?
  plan           String // MONTHLY | YEARLY
  subscriptionId String?
  raw            Json?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([platform, productId])
}

