# Database
# App runtime URL. Prefer one of:
#   - Prisma Accelerate / Prisma Postgres Accelerate: prisma://… or prisma+postgres://…
#     (required for query caching via cacheStrategy)
#   - Direct or pooled Postgres: postgresql://… or postgres://…@pooled.db.prisma.io/…
#     (works without Accelerate; caching is skipped automatically)
DATABASE_URL="postgresql://user:password@localhost:5432/ulearn?schema=public"

# Direct Postgres URL for `prisma migrate` / introspection / bulk copy.
# Required when DATABASE_URL is Accelerate (`prisma://`).
# For Prisma Postgres: use the *direct* host (db.prisma.io), NOT pooled.db.prisma.io.
# For local Postgres, set this to the same value as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/ulearn?schema=public"

# Optional: Accelerate URL when DATABASE_URL stays as direct/pooled Postgres.
# PRISMA_ACCELERATE_URL="prisma://accelerate.prisma-data.net/?api_key=..."


# Auth
JWT_SECRET="change-me-to-a-long-random-string"
# Optional: dedicated key for encrypting saved DB provider URLs in Admin
# DB_PROVIDER_SECRET="another-long-random-string"

# Encrypted mirror of Admin → Database Providers profiles (survives DB switches / redeploys).
# Copy from Admin → “Copy providers env” after saving providers. Required for safe switch-back.
# DB_PROVIDERS_CONFIG="enc:v1:..."
DEV_OTP="123456"

# App (must be your public HTTPS URL in production for Meta webhooks)
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Cloudflare R2
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="ulearn"
# Public CDN base for objects (Cloudflare R2 public bucket / custom domain).
# Required in production so ads, covers, and profile photos display.
# Example: https://pub-xxxxx.r2.dev   (no trailing slash)
R2_PUBLIC_URL=""

# ── Meta WhatsApp Cloud API ─────────────────────────────────────────────
# In Meta Developer Console → WhatsApp → Configuration → Webhook:
#
#   Callback URL:  {NEXT_PUBLIC_APP_URL}/api/webhooks/whatsapp
#   Verify token:  same value as WHATSAPP_VERIFY_TOKEN below
#
# Subscribe to webhook field: messages
#
# From Meta App Dashboard → WhatsApp → API Setup:
#   - Phone number ID  → WHATSAPP_PHONE_NUMBER_ID
#   - Temporary/permanent access token → WHATSAPP_ACCESS_TOKEN
#   - App Secret (Settings → Basic) → WHATSAPP_APP_SECRET (validates POST webhooks)

WHATSAPP_VERIFY_TOKEN="pick-a-long-random-string-for-meta"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""

# Optional: approved authentication template (recommended for production OTP)
# Create in Meta Business Manager → WhatsApp → Message templates → Authentication
WHATSAPP_OTP_TEMPLATE_NAME=""
WHATSAPP_OTP_TEMPLATE_LANG="ar"
WHATSAPP_OTP_TEMPLATE_USE_BUTTON="true"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="U Learn <noreply@ulearn.app>"

# Firebase Cloud Messaging
FCM_SERVER_KEY=""

# Vercel Cron (optional)
CRON_SECRET=""
